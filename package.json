{
  "name": "fadeloop",
  "version": "0.1.0",
  "description": "Self-hosted Instagram comment-to-DM automation using the official Meta Instagram API. Free, open-source, single-creator.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && npm run typecheck:ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply fadeloop --local",
    "db:migrate:remote": "wrangler d1 migrations apply fadeloop --remote",
    "build:auth": "node scripts/build-argon2.mjs",
    "predev": "npm run build:auth && npm run build:ui",
    "predeploy": "npm run build:auth && npm run build:ui",
    "owner:create": "node scripts/owner.mjs create",
    "owner:reset": "node scripts/owner.mjs reset",
    "deploy:dry-run": "npm run build:auth && npm run build:ui && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "session:login": "node scripts/session-login.mjs",
    "test:worker-auth": "npm run deploy:dry-run && node scripts/test-worker-auth.mjs",
    "test:ui": "npm run deploy:dry-run && node scripts/test-ui.mjs",
    "build:ui": "vite build --config frontend/vite.config.ts",
    "dev:ui": "vite --config frontend/vite.config.ts",
    "typecheck:ui": "tsc --project frontend/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "miniflare": "5.20260801.0-alpha",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^2.1.8",
    "wrangler": "^4.119.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hash-wasm": "4.12.0",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
